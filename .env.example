# Copy to .env (development) or .env.production (VPS) and fill in.
# Placeholders only; never commit real values.

# ---- Shared ----
NODE_ENV=development

# ---- API ----
PORT=3000
# Used when running the API on the host. docker-compose.yml overrides it with the
# in-network URL. Host tools need ?directConnection=true.
MONGODB_URI=mongodb://localhost:27017/exam_automation?replicaSet=rs0&directConnection=true

# JWT signing secrets: at least 32 characters, different from each other.
# Generate each with: openssl rand -base64 48
# Production refuses values that still start with "change-me".
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Comma-separated list of exact origins allowed by CORS (no wildcard, no trailing slash).
# Optional in development (defaults to http://localhost:5173); required in production.
CORS_ORIGIN=http://localhost:5173
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Reverse proxies in front of the API (Caddy in production sets 1 via docker-compose.prod.yml).
TRUST_PROXY=0
# Rate limit per IP on /api/v1: requests per window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Stricter per-IP limit on login, refresh and change-password.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
# Account lockout: after THRESHOLD consecutive failed logins the account locks for BASE_MS,
# doubling with each further failure up to MAX_MS. A successful login resets it.
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_BASE_MS=60000
AUTH_LOCKOUT_MAX_MS=3600000

# ---- Seed script (npm run seed -w @eas/api; also: make seed) ----
# Development only. Refuses to run with NODE_ENV=production unless ALLOW_PROD_SEED=true,
# and then SEED_PASSWORD is mandatory. In development it defaults to a documented dev password.
# SEED_PASSWORD=
# ALLOW_PROD_SEED=

# ---- Web ----
# Empty = same origin (Vite proxy in dev, Caddy in production).
VITE_API_URL=
# Where the Vite dev server proxies /api when run on the host.
API_PROXY_TARGET=http://localhost:3000

# ---- Development compose (host ports and names) ----
WEB_PORT=5173
API_PORT=3000
MONGO_PORT=27017
MONGO_DB=exam_automation
# Optional "tools" profile (mongo-express)
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=change-me

# ---- Production compose (docker-compose.prod.yml, file: .env.production) ----
# Public hostname Caddy serves, and the email used for Let's Encrypt.
DOMAIN=exam.example.com
ACME_EMAIL=admin@example.com
# Host ports for Caddy (defaults 80 and 443).
HTTP_PORT=80
HTTPS_PORT=443
# MongoDB root account (created on first start) and replica-set keyfile content.
# Generate the key with: openssl rand -base64 48
MONGO_INITDB_ROOT_USERNAME=eas_root
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_REPLICA_KEY=change-me-use-openssl-rand-base64-48
# In production set MONGODB_URI to:
#   mongodb://<user>:<password>@mongo:27017/exam_automation?replicaSet=rs0&authSource=admin
