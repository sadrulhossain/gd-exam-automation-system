{
  "name": "@eas/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:poll": "nodemon --legacy-watch --watch src --watch ../../packages --ext ts,json --ignore \"**/node_modules/**\" --ignore \"**/dist/**\" --exec \"tsx --conditions=source src/index.ts\""
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@eas/allocation": "^0.0.0",
    "@eas/shared": "^0.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15"
  }
}
